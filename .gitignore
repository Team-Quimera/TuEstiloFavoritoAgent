# Tu Estilo Favorito — .gitignore (PRODUCCION)
# Este repo SI sube agent/, config/, tests/ a GitHub para que Railway los deployee.
# Solo se excluyen secretos y artefactos locales.

# Secretos — NUNCA subir
.env
.env.local
.env.*.local

# Base de datos local
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Knowledge — info publica del negocio (catalogo, precios, ubicacion, FAQ)
# SI se sube al repo para que Railway tenga acceso al desplegar.
# EXCEPTO archivos privados con datos de clientes:
knowledge/_leads_registrados.txt
knowledge/_*.txt
knowledge/*.private.*

# Session state de AgentKit
config/session.yaml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Docker
.dockerignore

# Node (si se usa para Claude Code)
node_modules/
