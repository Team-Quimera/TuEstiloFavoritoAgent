# Tu Estilo Favorito — .gitignore (PRODUCCION)
# Este repo SI sube agent/, config/, tests/ a GitHub para que Railway los deployee.
# Solo se excluyen secretos y artefactos locales.

# Secretos — NUNCA subir
.env
.env.local
.env.*.local

# Base de datos local
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Knowledge — archivos privados del cliente
# (mantenemos solo .gitkeep para preservar la carpeta)
knowledge/*
!knowledge/.gitkeep

# Leads registrados localmente (info sensible de clientes)
knowledge/_leads_registrados.txt

# Session state de AgentKit
config/session.yaml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Docker
.dockerignore

# Node (si se usa para Claude Code)
node_modules/
